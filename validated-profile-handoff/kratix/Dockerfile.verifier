# Build context: rc-demos root. The verification executable does not require the
# producer's profiler/resolver dependencies.
FROM golang:1.27.3-alpine AS build
WORKDIR /src
COPY validated-profile-handoff/go.mod validated-profile-handoff/go.sum ./
COPY validated-profile-handoff/handoff ./handoff
COPY validated-profile-handoff/kratixgate ./kratixgate
COPY validated-profile-handoff/cmd/verify-kratix ./cmd/verify-kratix
RUN go mod edit -droprequire=github.com/runtimeconditions/go-rc-profiler \
    -droprequire=github.com/runtimeconditions/rc-extension-resolver && \
    CGO_ENABLED=0 go build -trimpath -o /verify ./cmd/verify-kratix

FROM alpine:3.22
COPY --from=build /verify /usr/local/bin/verify
ENTRYPOINT ["/usr/local/bin/verify"]
